#!/bin/bash
{#- jinja2: lstrip_blocks: true, trim_blocks: true -#}
# {{ ansible_managed }}
# Certificate expiry monitoring script for ACME-managed certificates.
# Exit codes: 0 = OK, 1 = WARNING, 2 = CRITICAL, 3 = UNKNOWN
#
# Usage:
#   {{ acme_monitoring_script_path }}              # Check all certificates, verbose output
#   {{ acme_monitoring_script_path }} --quiet      # Only output warnings/criticals
#   {{ acme_monitoring_script_path }} --json       # JSON output for machine consumption
#   {{ acme_monitoring_script_path }} --nagios     # Nagios-compatible output
set -euo pipefail

WARNING_DAYS="{{ acme_monitoring_warning_days }}"
CRITICAL_DAYS="{{ acme_monitoring_critical_days }}"
CERT_DIR="{{ acme_cert_dir }}"
QUIET=false
JSON=false
NAGIOS=false
EXIT_CODE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --quiet|-q) QUIET=true; shift ;;
        --json|-j)  JSON=true; shift ;;
        --nagios|-n) NAGIOS=true; shift ;;
        *) echo "Unknown option: $1" >&2; exit 3 ;;
    esac
done

declare -a RESULTS=()

check_cert() {
    local name="$1"
    local cert_path="${CERT_DIR}/${name}/fullchain.pem"

    if [[ ! -f "${cert_path}" ]]; then
        RESULTS+=("{\"name\":\"${name}\",\"status\":\"UNKNOWN\",\"message\":\"certificate file not found\"}")
        [[ ${EXIT_CODE} -lt 3 ]] && EXIT_CODE=3
        return
    fi

    local expiry_date
    expiry_date=$(openssl x509 -in "${cert_path}" -noout -enddate 2>/dev/null | cut -d= -f2)
    if [[ -z "${expiry_date}" ]]; then
        RESULTS+=("{\"name\":\"${name}\",\"status\":\"UNKNOWN\",\"message\":\"cannot parse certificate\"}")
        [[ ${EXIT_CODE} -lt 3 ]] && EXIT_CODE=3
        return
    fi

    local expiry_epoch
    expiry_epoch=$(date -d "${expiry_date}" +%s 2>/dev/null || date -jf "%b %d %T %Y %Z" "${expiry_date}" +%s 2>/dev/null)
    local now_epoch
    now_epoch=$(date +%s)
    local days_left=$(( (expiry_epoch - now_epoch) / 86400 ))

    local status="OK"
    if [[ ${days_left} -le ${CRITICAL_DAYS} ]]; then
        status="CRITICAL"
        [[ ${EXIT_CODE} -lt 2 ]] && EXIT_CODE=2
    elif [[ ${days_left} -le ${WARNING_DAYS} ]]; then
        status="WARNING"
        [[ ${EXIT_CODE} -lt 1 ]] && EXIT_CODE=1
    fi

    local domains
    domains=$(openssl x509 -in "${cert_path}" -noout -text 2>/dev/null | grep -oP '(?<=DNS:)[^,\s]+' | tr '\n' ',' | sed 's/,$//')

    RESULTS+=("{\"name\":\"${name}\",\"status\":\"${status}\",\"days_left\":${days_left},\"expiry\":\"${expiry_date}\",\"domains\":\"${domains}\"}")
}

# Check all managed certificates
{% for cert in acme_certificates %}
{% if cert.enabled | default(true) %}
check_cert "{{ cert.name }}"
{% endif %}
{% endfor %}

# Output results
if ${JSON}; then
    echo "["
    for i in "${!RESULTS[@]}"; do
        if [[ $i -lt $((${#RESULTS[@]} - 1)) ]]; then
            echo "  ${RESULTS[$i]},"
        else
            echo "  ${RESULTS[$i]}"
        fi
    done
    echo "]"
elif ${NAGIOS}; then
    for result in "${RESULTS[@]}"; do
        name=$(echo "${result}" | grep -oP '"name":"[^"]*"' | cut -d'"' -f4)
        status=$(echo "${result}" | grep -oP '"status":"[^"]*"' | cut -d'"' -f4)
        days=$(echo "${result}" | grep -oP '"days_left":[0-9]*' | cut -d: -f2)
        echo "CERT ${status} - ${name}: ${days:-?} days until expiry"
    done
else
    for result in "${RESULTS[@]}"; do
        name=$(echo "${result}" | grep -oP '"name":"[^"]*"' | cut -d'"' -f4)
        status=$(echo "${result}" | grep -oP '"status":"[^"]*"' | cut -d'"' -f4)
        days=$(echo "${result}" | grep -oP '"days_left":[0-9]*' | cut -d: -f2)
        expiry=$(echo "${result}" | grep -oP '"expiry":"[^"]*"' | cut -d'"' -f4)
        domains=$(echo "${result}" | grep -oP '"domains":"[^"]*"' | cut -d'"' -f4)

        if ${QUIET} && [[ "${status}" == "OK" ]]; then
            continue
        fi

        echo "[${status}] ${name} — expires in ${days:-?} days (${expiry:-unknown})"
        [[ -n "${domains}" ]] && echo "         domains: ${domains}"
    done
fi

exit ${EXIT_CODE}

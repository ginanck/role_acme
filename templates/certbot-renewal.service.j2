{#- jinja2: lstrip_blocks: true, trim_blocks: true -#}
# {{ ansible_managed }}

[Unit]
Description=Certbot certificate renewal
Documentation=https://certbot.eff.org/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Trust root and client environment shared with initial issuance.
EnvironmentFile=-{{ acme_renewal_env_file }}
# certbot executes executable scripts in renewal-hooks/{pre,post,deploy} itself.
# No --deploy-hook/--renew-hook flag is passed here, which avoids pointing at a
# script that may not exist and keeps deploy hooks in the directory certbot
# scans after every successful renewal.
ExecStart={{ acme_certbot_bin }} renew --quiet
PrivateTmp=true
